# Implements PHASE_1_SPEC.md §8. Identical builder to Dockerfile.api; different CMD.
FROM python:3.13-slim AS builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN pip install --upgrade pip hatchling
COPY pyproject.toml README.md ./
COPY apps/ apps/
COPY packages/ packages/
COPY migrations/ migrations/
COPY scripts/ scripts/
RUN pip install --prefix=/install ".[dev]" "packaging>=24.0"

FROM python:3.13-slim AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app
WORKDIR /app
COPY --from=builder /install /usr/local
RUN pip install --no-cache-dir "packaging>=24.0"
COPY apps/ apps/
COPY packages/ packages/
COPY migrations/ migrations/
COPY scripts/ scripts/
COPY alembic.ini ./
COPY fixtures/retention_v1.json fixtures/retention_v1.json
CMD ["celery", "-A", "apps.worker.celery_app", "worker", "--loglevel=INFO", "--concurrency=4"]
