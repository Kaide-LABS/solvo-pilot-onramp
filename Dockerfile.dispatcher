# Implements PHASE_6_SPEC.md §1 — Cloud Run dispatcher-beat service.
FROM python:3.13-slim-bookworm AS builder
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN pip install --no-cache-dir --upgrade pip hatchling
COPY pyproject.toml ./
COPY apps/ apps/
COPY packages/ packages/
COPY migrations/ migrations/
RUN pip install --no-cache-dir --prefix=/install ".[dev]"

FROM python:3.13-slim-bookworm AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app
WORKDIR /app
COPY --from=builder /install /usr/local
COPY apps/ apps/
COPY packages/ packages/
COPY migrations/ migrations/
COPY alembic.ini ./
COPY fixtures/retention_v1.json fixtures/retention_v1.json
# Single process that runs both the beat scheduler and a single worker thread.
# Worker processes that pick up tasks live in Dockerfile.worker / separate Cloud Run service.
CMD ["celery", "-A", "apps.worker.celery_app", "beat", "--loglevel=INFO"]
